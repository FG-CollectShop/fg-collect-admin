# Copy to .env.local for dev (NEVER commit .env.local).
#
# Vite-style env vars: only those prefixed with VITE_ are exposed to the
# client bundle. Firebase web config IS public-by-design (it's part of every
# Firebase web app); the security comes from server-side ID-token verification
# + the email allowlist in fg-collect-core.

# fg-collect-core API base URL.
# Local dev:    http://localhost:8080
# Production:   https://api.<your-domain>
VITE_API_BASE=http://localhost:8080

# Firebase web app config — paste from Firebase console:
# Project Settings → General → Your apps → Web app → Config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
